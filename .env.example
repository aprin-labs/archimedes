# Archimedes — environment variables template
#
# Copy this file to `.env` and fill in the values. The `.env` file is gitignored;
# never commit it.
#
#   cp .env.example .env
#
# Required for `docker compose up` to start the local stack. Most defaults work
# out of the box for local development. Generate BETTER_AUTH_SECRET below;
# without an LLM credential the app still runs but strategy intelligence falls
# back to canned output. Arc wallet / RPC / Circle variables are optional locally
# (skip on-chain features).

# ── Compose profile: run the in-stack Postgres + Redis locally ─────────────
# LOCAL DEV keeps this set so `docker compose up` brings up the full
# self-contained stack (postgres + redis + app). PRODUCTION leaves it UNSET:
# the postgres/redis services are profile-gated (profiles: ["localdb"] in
# docker-compose.yml), so without this they don't start and the app talks to
# managed Aurora + ElastiCache via DATABASE_URL / REDIS_URL below. One compose
# file, two topologies — see docs/deployment.md.
#
# `runners` (#1043) is a SEPARATE profile gating oracle/agent/kb-runner —
# funds-adjacent exactly-once singleton processes (see
# backend/archimedes/services/runner_lease.py). Left OUT of the default here
# on purpose: a bare `docker compose up` for local UI/demo work should never
# accidentally spin up a second live copy racing whatever the operator
# already has running elsewhere (or start real on-chain writers with no
# reason to). To exercise them locally, opt in explicitly:
#   COMPOSE_PROFILES=localdb,runners docker compose up -d --build
# PRODUCTION: this compose file doubles as the box's live deploy target
# (deploy.yml runs `docker compose up -d` against it), but production is
# SELF-HEALED — .github/workflows/deploy.yml idempotently ensures `runners`
# is present in the box's own COMPOSE_PROFILES on every deploy, so
# oracle/agent/kb-runner keep starting there with no manual step. If you set
# COMPOSE_PROFILES yourself on the box, deploy.yml appends `,runners` to it
# rather than overwriting it. The `localdb`-only default in this template is
# for LOCAL inert-demo mode only.
# Include strict local migration ordering. Production omits COMPOSE_FILE and
# runs the same migration as a pre-rollout ECS task instead.
COMPOSE_PATH_SEPARATOR=:
COMPOSE_FILE=docker-compose.yml:docker-compose.local.yml
COMPOSE_PROFILES=localdb

# ── Image source: local build (default) vs ECR pull ────────────────────────
# LEAVE BOTH COMMENTED OUT. docker-compose.yml resolves every app-tier service
# to a project-scoped, registry-less tag
# (`${COMPOSE_PROJECT_NAME:-archimedes}-backend:local`), so the only thing that
# can satisfy it is your own `docker compose up --build`. That is deliberate:
# these keys used to default to the live production ECR ref, so a bare
# `docker compose up` — no `--build` — reached the production registry and, on
# an ECR-authenticated machine, silently ran the last image CI pushed to prod
# instead of your working tree (#1044, leak 3). The scoping by project name
# also stops one worktree's build from overwriting the tag every other checkout
# on the machine resolves.
#
# To run prebuilt ECR images instead, opt in explicitly — name the overlay AND
# set both variables (they are `:?`-required in the overlay, so a forgotten one
# errors rather than silently selecting production `:latest`):
#
#   aws ecr get-login-password --region us-east-1 \
#     | docker login --username AWS --password-stdin "$ECR_REGISTRY"
#   ECR_REGISTRY=037613907429.dkr.ecr.us-east-1.amazonaws.com IMAGE_TAG=<sha> \
#     docker compose -f docker-compose.yml -f docker-compose.ecr.yml pull
#
# Neither variable affects production: since the Fargate cutover, deploy.yml
# registers ECS task definitions with explicit image URIs and never runs
# compose. See docker-compose.ecr.yml.
#ECR_REGISTRY=037613907429.dkr.ecr.us-east-1.amazonaws.com
#IMAGE_TAG=latest

# Rootless Docker cannot publish privileged host ports (<1024) by default.
# Production omits this variable and keeps docker-compose.yml's port-80 fallback.
ARCHIMEDES_HTTP_PORT=8080

# ── PostgreSQL (the local docker compose stack starts a server with these) ──
# LOCAL-DEV ONLY. This is a throwaway local password, NOT a production secret —
# the EC2 bootstrap (infra/user-data.sh) generates a random password at boot.
# Never reuse this value anywhere real. Keep the two lines in sync if you change it.
POSTGRES_USER=archimedes
POSTGRES_PASSWORD=local-dev-only-change-me
POSTGRES_DB=archimedes
DATABASE_URL=postgresql://archimedes:local-dev-only-change-me@postgres:5432/archimedes

# ── Redis ──────────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0

# ── LLM — the one credential that unlocks REAL strategy intelligence ──────
# Powers strategy fusion, the architect, reasoning-trace generation,
# arxiv passport extraction, AND the agentic portfolio advisor (PortfolioAgent).
# Leave ALL of these blank and the app still boots, but those paths use a
# CANNED fallback (not real intelligence) — degraded loudly via /health.
#
# Provider-agnostic: set LLM_PROVIDER + provider-specific vars.
# Supported: bedrock_converse (PROD DEFAULT), anthropic, anthropic_compatible, bedrock, openai, ollama
#
#  (E) AWS Bedrock Converse — the PRODUCTION default (Amazon Nova Micro). IAM
#      auth via the EC2 instance role (no key); ANY Bedrock provider works
#      (Nova / Llama / Mistral / DeepSeek / GLM / Kimi / …) via LLM_BEDROCK_MODEL.
#      Local dev needs AWS creds to invoke; without them the app degrades to
#      canned output (loud via /health) — same as leaving every provider blank.
#        LLM_PROVIDER=bedrock_converse
#        LLM_BEDROCK_MODEL=amazon.nova-micro-v1:0
#
#  (A) Anthropic-compatible endpoint (e.g. GLM via z.ai):
#        LLM_PROVIDER=anthropic_compatible
#        LLM_AUTH_TOKEN=<token>
#        LLM_BASE_URL=https://api.z.ai/api/anthropic
#
#  (B) Direct Anthropic API key:
#        LLM_PROVIDER=anthropic
#        LLM_API_KEY=<key from https://console.anthropic.com>
#
#  (C) OpenAI-compatible endpoint:
#        LLM_PROVIDER=openai
#        LLM_API_KEY=<key>
#        LLM_BASE_URL=https://api.openai.com/v1
#
#  (D) Local Ollama — no key, no cloud creds. Run `ollama pull llama3.1` on
#      the HOST first (`available` now probes GET {base_url}/api/tags and
#      falls back to canned output if the model isn't pulled — issue #1044).
#      From INSIDE the docker-compose stack, "localhost" is the container
#      itself, not your host — use host.docker.internal (mapped for the
#      `backend`/`oracle`/`agent` services below via extra_hosts — kb-runner
#      has none and needs none: it never calls an LLM). Running the backend
#      bare (not in compose) can use localhost instead.
#        LLM_PROVIDER=ollama
#        LLM_MODEL=llama3.1
#        LLM_BASE_URL=http://host.docker.internal:11434
#
# Default matches production: AWS Bedrock Converse + Amazon Nova Micro.
LLM_PROVIDER=bedrock_converse
LLM_BEDROCK_MODEL=amazon.nova-micro-v1:0
# (anthropic / anthropic_compatible / openai paths use these instead — leave
# blank on the bedrock_converse path):
LLM_API_KEY=
LLM_AUTH_TOKEN=
LLM_BASE_URL=
LLM_MODEL=
#
# Back-compat (deprecated — migrate to LLM_* above):
ANTHROPIC_AUTH_TOKEN=
ANTHROPIC_BASE_URL=
ANTHROPIC_API_KEY=

# ── Arc testnet RPC (per-developer, from `arc-canteen login`) ──────────────
# Source ~/.arc-canteen/env in your shell to populate $RPC automatically.
# For docker-compose you can paste the value here, but it's per-user and
# secret — do NOT commit. Leave blank to skip on-chain features locally.
RPC=

# ── Two-chain split: payments vs execution (#1240) ─────────────────────────
# LEAVE ALL FOUR BLANK unless you are deliberately running a split. Blank means
# both roles use the single-chain settings (ARC_CHAIN_ID / ARC_ARC_RPC_URL, or
# their defaults), which is exactly how the system behaves today.
#
# At the Arc mainnet cutover the payment rail (USDC / x402 / Gateway /
# PaymentSplitter) moves to mainnet while vault, synth, AMM and oracle
# execution stays on testnet. These four are how that is expressed.
#
# SET BOTH HALVES OF A PAIR OR NEITHER. A chain id without its endpoint (or an
# endpoint without its id) makes the process REFUSE TO START, naming the
# missing variable. That is deliberate: filling the missing half from the
# single-chain settings would settle real USDC against an endpoint nobody chose
# while reporting a chain nobody chose.
#
# Every contract address in this file belongs to the EXECUTION chain.
ARC_PAYMENTS_CHAIN_ID=
ARC_PAYMENTS_RPC_URL=
ARC_EXECUTION_CHAIN_ID=
ARC_EXECUTION_RPC_URL=

# ── Wallet (dev only — never put a wallet with real funds here) ────────────
# Generate a fresh dev wallet for hackathon testing. Cast example:
#   cast wallet new
# Then paste the address + private key. NEVER commit a key with real funds.
DEV_WALLET_ADDRESS=
DEV_WALLET_PRIVATE_KEY=

# Agent harness account credentials and optional wallet-link key. Values stay in
# local environment only; use fresh test account/key, never funded/mainnet key.
ARCHIMEDES_EMAIL=
ARCHIMEDES_PASSWORD=
AGENT_WALLET_KEY=

# Dev-only Circle API key for the testnet faucet mode of scripts/
# fund_agent_wallet.py (Bearer auth) — never commit a real value.
CIRCLE_API_KEY=

# ── Circle Developer Controlled Wallets ───────────────────────────────────
# Used by the oracle runner to push prices on-chain via the Circle wallet
# that owns the PriceOracle contracts (address 0xc221dC...9aC9).
# CIRCLE_API_KEY and CIRCLE_ENTITY_SECRET come from the Circle Developer Console.
# WALLET_ID is the Circle wallet UUID, WALLET_ADDRESS is its EVM address.
CIRCLE_API_KEY=
CIRCLE_ENTITY_SECRET=
WALLET_ID=
WALLET_ADDRESS=
WALLET_SET_ID=

# ── Vault governance owner (non-custodial, T0.2) ───────────────────────────
# Cold/governance key that OWNS backend-bootstrapped & auto-created vaults
# (the onlyOwner admin: setTokenOracles, setMaxSlippageBps, setAgent, pause).
# MUST be DISTINCT from the hot agent signer (WALLET_ADDRESS) so a compromised
# agent key cannot re-point oracles or pause/drain a vault — the agent keeps
# rebalance-only authority. Used ONLY when no end-user wallet is available
# (bootstrap_vaults.py, agent auto-create). User-facing /vaults/create passes
# current user's verified linked wallet as owner instead and does NOT use this.
# If unset, those backend-created vaults stay owned by the agent (custodial)
# and the backend logs a loud warning — it never silently transfers to the
# agent. Set a cold key here for a true non-custodial bootstrap. The address
# format is checksummed 0x… ; generate a fresh key with: cast wallet new
ARC_VAULT_GOVERNANCE_ADDRESS=

# ── Subscription marketplace (PR #958) ─────────────────────────────────────
# The marketplace publish/subscribe engine and its x402 settlement sweep.
# All THREE below are runtime-required for real (non-dry) operation — the
# publish route 503s and the settlement sweep 502s when any is unset.
#
# ARCHIMEDES_TREASURY_WALLET: the platform's revenue-share address, injected
#   server-side at pool creation (the 10% platform split). NEVER client-set.
#   Publishing is refused (503) until this is configured. Checksummed 0x… .
ARCHIMEDES_TREASURY_WALLET=
# PLATFORM_ADMIN_WALLETS: comma- or space-separated allowlist of wallet
#   addresses granted platform-admin capabilities. Two consumers today:
#   1. Publishing EXAMPLE strategies (is_example=true) that the wallet did not
#      generate — the sole exception to the D5 "only the generator may
#      publish" rule (see wallet_can_publish in models/strategy_generators.py).
#   2. Reading the internal cost/ops dashboard, GET /api/metrics/private/*
#      (see require_platform_admin in api/metrics_private_routes.py) — a
#      signed-in non-admin gets 403 there, not just any authenticated user.
#   For (2), as of #1648 this list is EVIDENCE, not the per-request lookup key:
#   an ACCOUNT is admin when any wallet in its own linked-wallet set is listed
#   here. It no longer matters which wallet the caller's browser happens to
#   have connected (that used to decide, via the X-Wallet-Address header, so
#   the Insights page appeared and disappeared across browsers). No config
#   change is needed for an existing deploy.
#   Parsed case-insensitively; a stray leading/trailing comma is harmless.
#   Grants NO fund/custody/treasury authority — a listed wallet must still
#   sign in and link the wallet to an account for either capability. Empty by
#   default (no admin wallets).
PLATFORM_ADMIN_WALLETS=
# PLATFORM_ADMIN_ACCOUNTS: comma- or space-separated allowlist of CANONICAL
#   ACCOUNT identifiers — Better Auth `auth_users.id` values and/or the
#   account's email address — granted the same dashboard access as (2) above.
#   This is the canonical key added by #1648: admin belongs to the account,
#   and a wallet is only evidence of which account that is. Two reasons to
#   prefer it: admin survives unlinking/rotating a wallet, and it is answered
#   from the session plus this env alone — no account-store read — so the ops
#   dashboard stays reachable during a database incident.
#   User ids match case-SENSITIVELY (they are opaque tokens; folding case
#   would let one entry match two accounts); emails match case-insensitively.
#   Derive the value for an existing deploy with
#   `python backend/scripts/derive_platform_admin_accounts.py`. Empty by
#   default. Grants NO fund/custody/treasury authority either.
PLATFORM_ADMIN_ACCOUNTS=
# ARC_PAYMENT_SPLITTER_ADDRESS: the deployed PaymentSplitter contract (set
#   after the T3.2 deploy). The settlement sweep deposits/withdraws here.
ARC_PAYMENT_SPLITTER_ADDRESS=
# CIRCLE_BLOCKCHAIN: Circle network id for provisioned subscriber/publisher
#   Developer-Controlled Wallets. Defaults to ARC-TESTNET in code.
CIRCLE_BLOCKCHAIN=ARC-TESTNET
# PAYMENTS_DRY_RUN: FAIL-SAFE money switch. Defaults to true (no real charges).
#   Set to false ONLY deliberately, together with real PAPER_TRADING intent —
#   an out-of-the-box deploy must never charge real USDC.
PAYMENTS_DRY_RUN=true
# PAYMENTS_HALT: NO-REDEPLOY kill switch for real charges (issue #1240).
#   PAYMENTS_DRY_RUN above is the primary safety switch, but MarketService
#   reads it once at construction (main.py boot) and caches it — flipping it
#   off requires the full build -> ECR -> roll Fargate deploy pipeline.
#   PAYMENTS_HALT is instead read fresh from os.environ on EVERY charge
#   (marketplace.config.payments_halted), so an operator can stop real money
#   moving without a deploy. Wired into six real-money call sites: the
#   tick-charging rail (MarketService._charge_one — subscriber stays active,
#   only the charge itself is suppressed), the metered generation paywall
#   (generation_payment.enforce_generation_payment — REFUSES service with a
#   503 while halted, it does not comp the paid product for free), the
#   automatic per-tick settlement sweep (SettlementSweeper.sweep_publisher —
#   skips the Gateway withdraw / on-chain gatewayMint / depositToPool chain
#   entirely while halted, same as it already does for PAYMENTS_DRY_RUN), and
#   the two on-demand withdraw paths — SettlementSweeper.withdraw_publisher
#   (Withdraw button: PaymentSplitter.withdraw) and
#   SettlementSweeper.withdraw_subscriber (unsubscribe refund: DCW USDC
#   transfer) — both reachable directly from authenticated endpoints without
#   going through sweep_publisher, so they carry the same guard rather than
#   inheriting it. The sixth is the platform revenue sweep
#   (services/revenue_sweep.py sweep_revenue — Gateway balance -> DCW tokens),
#   which is deliberately INDEPENDENT of PAYMENTS_DRY_RUN (that switch asks
#   "may we charge a user?"; the sweep moves the platform's own funds) but is
#   NOT independent of this one, which asks "may a Circle call move USDC?" —
#   and GatewayClient.withdraw plainly does. Both its entry points are
#   covered, the hourly loop and the CLI; `--check` still reads balances while
#   halted.
#   NOT gated, because none of them can move USDC: the generation credit
#   ledger (#1441/#1498 — claim/settle/consume/void/restore are DB rows for an
#   entitlement a Circle settle already created, and freezing consume/restore
#   would withhold a credit the payer already bought), payment-receipt writes
#   and reads, balance reads, and vault trade execution (non-custodial, gated
#   by PAPER_TRADING). marketplace/config.py's payments_halted() docstring
#   carries the authoritative inventory.
#   Defaults to false (not halted) — PAYMENTS_DRY_RUN remains the primary,
#   default-on safety net.
#   Operator procedure at 3am: set PAYMENTS_HALT=true under the same SSM
#   prefix AWS_SSM_PATH_PREFIX points at (e.g. /archimedes/prod/PAYMENTS_HALT),
#   then `aws ecs update-service --cluster <cluster> --service <service>
#   --force-new-deployment` — a same-image task restart, not a new build.
PAYMENTS_HALT=false
# CIRCLE_API_KEY / CIRCLE_ENTITY_SECRET (above) also gate DCW provisioning —
# without them subscribe/publish 502 at wallet-provision time.
# MARKETPLACE_SPEND_CAP_USDC: per-subscriber-wallet rolling 24h USDC spend cap
#   (issue #713) — a wallet at/over this cap is refused further charges
#   (marketplace/spend_cap.py, wired into MarketService._charge_one) and new
#   subscriptions (429 on POST /api/marketplace/subscribe). Default 50 is a
#   placeholder, not a risk-modeled number; set to 0 to disable the check.
MARKETPLACE_SPEND_CAP_USDC=50

# ── Generation volume caps (services/generation_quota.py, #1194 rev a) ────
# Two stacked DAILY caps on /api/generate/start; BOTH must pass. Bounds LLM
# spend: per-account for fairness, per-IP so minting disposable accounts from
# one address gains nothing (accounts are cheap until email verification
# ships). <= 0 disables a layer individually. Fail-closed on Redis errors —
# deliberate: the generate path's job queue needs the same Redis, so failing
# open would only uncap spend in exactly the degraded state.
GENERATION_DAILY_CAP_PER_USER=100
GENERATION_DAILY_CAP_PER_IP=200
# Admission control: how many generation pipelines may RUN at once (one
# pipeline ≈ 65% of the prod task's vCPU, so raise only with task CPU) and
# how many more may WAIT in queue before /start refuses 429 pre-payment.
GENERATION_MAX_CONCURRENT=1
GENERATION_MAX_QUEUE=10

# ── Free generations before the wallet gate (#1643, owner 2026-08-31) ─────
# LIFETIME free generations per ACCOUNT — not a daily bucket. This is a
# different axis from the two caps above: they reset every UTC day, this one
# never does (a durable `free_generation_grants` row per spent slot, so a
# Redis flush cannot regrant it). An account is still REQUIRED for every
# generation; only the wallet becomes optional, and only for these first N,
# and only once that account's email is VERIFIED (owner decision D1,
# 2026-08-31): accounts are free and unlimited, a working inbox is not, so
# verification is what prices disposable-account farming of free LLM runs. An
# unverified account is not refused — it gets the wallet + payment path, which
# is exactly the behaviour before the free tier existed.
# Applies only when GENERATION_PAYMENT_REQUIRED=true — with the paywall off
# nothing is gated, so no allowance is spent. <= 0 disables the free path and
# restores the pre-#1643 wallet-gate-on-the-first-call behaviour exactly.
FREE_GENERATIONS_PER_ACCOUNT=3

# ── Generation payment gate (x402; Dan's directive 2026-08-19) ────────────
# Past the free allowance above, generation requires wallet connection +
# payment when the flag is "true" (paper trading stays free). Flag-gated for a deliberate flip — see the #834
# flip-list. Recipient MUST be set before the flag (flag-on without a
# recipient is a 503 outage, never a free pass). Flat price is the #1217 seam:
# the measured per-generation budget replaces it later.
GENERATION_PAYMENT_REQUIRED=false
# Generation-scoped dry-run: set false to really verify+settle generation
# payments while the global PAYMENTS_DRY_RUN stays true (marketplace stays
# dry, #975). Unset inherits PAYMENTS_DRY_RUN.
# Platform revenue sweep (services/revenue_sweep.py): Gateway balance -> the
# recipient DCW's token balance. REVENUE_WALLET_ID = that DCW's Circle wallet
# id. The scheduler loop arms ONLY on the literal "true"; the CLI
# (python -m archimedes.services.revenue_sweep --check|--sweep) always works.
REVENUE_WALLET_ID=
REVENUE_SWEEP_ENABLED=
REVENUE_SWEEP_MIN_USDC=10.0
GENERATION_PAYMENTS_DRY_RUN=
GENERATION_PRICE_USD=2.00
GENERATION_PAYMENT_RECIPIENT=

# ── Email encryption at rest ──────────────────────────────────────────────
# REQUIRED when PUBLIC_DOMAIN is set (production). Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# Without this, app startup will fail in production (fail-closed).
# For local dev, a default key is used (see services/email_crypto.py).
EMAIL_ENCRYPTION_KEY=

# Legacy test-only SIWE login cookie key. Live auth uses BETTER_AUTH_SECRET;
# wallet linking stores no SIWE login session. Leave blank outside compatibility tests.
SIWE_SESSION_KEY=

# ── Internal agent authentication ─────────────────────────────────────────
# Required by internal endpoints (traces/publish, agent/bootstrap-liquidity).
# Generate with `openssl rand -hex 32`.
# The agent runner must send this as `X-Internal-Agent-Key` on its requests.
# If unset, all guarded endpoints return 403 (fail-closed).
INTERNAL_AGENT_API_KEY=

# Generation always requires Better Auth account session. No local wallet-auth
# bypass exists; public read routes remain anonymous.

# How often the oracle runner pushes prices (seconds, default 60).
ORACLE_INTERVAL_SECONDS=60

# ── Market-data vendor, per seam (#1218 / #1798) ───────────────────────────
# Two variables, because the two seams have different vendors. Both default to
# yfinance, so leaving both unset is exactly today's behaviour.
#   MARKET_DATA_DAILY_PROVIDER — DAILY BARS: strategy signal evaluation
#     (marketplace ticks, vault and paper), the generation fusion panel, the
#     portfolio backtester. This is the one to flip to 'tiingo' for the
#     licensed-data cutover. Unset → falls back to MARKET_DATA_PROVIDER →
#     yfinance.
#   MARKET_DATA_PROVIDER — INTRADAY/HISTORY: the live oracle push, the crypto
#     seam leg, the VIX/S&P regime reads, the paper-marks loop, the #775
#     cross-check, the Explore history modal. Tiingo cannot serve this seam
#     (daily bars only), so setting it to 'tiingo' logs the substitution and
#     leaves this seam on yfinance — it does not break the oracle.
# A vendor is chosen per seam, never per method inside one run: see
# docs/adr/market-data-sourcing.md § "Amendment: per-seam routing" for the
# feature → seam table.
# MARKET_DATA_DAILY_PROVIDER=yfinance
# MARKET_DATA_PROVIDER=yfinance

# ── Tiingo credential (#1218 — yfinance replacement) ───────────────────────
# Only required when a seam resolves to tiingo (backend/archimedes/services/market_data_provider.py); unused otherwise.
# Leave BLANK unless you have your own token. Blank + both provider vars at
# their yfinance default is the fail-safe state: the yfinance path is
# unchanged. Blank + a tiingo-resolved seam REFUSES LOUDLY at provider
# construction — it never falls back to yfinance, because a run that silently
# changed vendor mid-flight would mix two vendors' bars into one backtest.
# Decision + rationale: docs/adr/market-data-sourcing.md.
# Prod: SSM Parameter Store, SecureString, /archimedes/prod/TIINGO_API_TOKEN
# (owner-seeded; wired into the backend task definition on both paths by #1798 —
# the infra/ecs.tf `secrets` twin and .github/scripts/ecs_rewrite_task_def.py, the
# path that actually ships — so it is a task-launch dependency, not only the
# best-effort /archimedes/prod/ SSM path load at boot).
# NEVER commit a real token here.
TIINGO_API_TOKEN=
# Legacy alias for the same credential, still read if TIINGO_API_TOKEN is unset.
# Prefer TIINGO_API_TOKEN; this exists so an existing local .env keeps working.
# TIINGO_API_KEY=

# Politeness floor between consecutive Tiingo HTTP requests, in seconds.
# Free-tier accounts are metered per hour and per day; this paces our own
# requests rather than encoding a published ceiling we cannot verify from
# inside the process. Tiingo's own HTTP 429 (surfaced as TiingoRateLimitError,
# with its Retry-After) remains the authority on the real limit.
# 0 disables pacing. Default 1.1 (0 under TESTING).
# TIINGO_MIN_REQUEST_INTERVAL_S=1.1

# ── Off-chain price source (North Star §10.5) ─────────────────────────────
# Where the off-chain price comes from BEFORE it's pushed on-chain. No contract
# change — PriceOracle.sol's setPrice() is untouched. Default 'yfinance' keeps
# the legacy behavior exactly (a deploy is a no-op until you flip this).
#   yfinance    — legacy (yfinance + CoinGecko). Default.
#   cascade     — Pyth Hermes for covered symbols (TSLA/NVDA/SPY/GOLD/BTC),
#                 yfinance for the rest, CoinGecko for crypto Pyth misses.
#   pyth_hermes — Pyth only (no yfinance/CoinGecko fallback).
# The cascade is the safety net; Pyth prices carry their own publish_time so the
# existing staleness/deviation push-gates stay meaningful (stale equity feeds
# off-hours are correctly rejected → fall back).
PRICE_SOURCE=yfinance

# ── Oracle crypto source order (#1710) ────────────────────────────────────
# Which source prices the push set's CRYPTO synths, and in what order. Before
# #1710 this leg was hardcoded to CoinGecko with NO fallback and no connection
# to the MARKET_DATA_PROVIDER seam, so a CoinGecko miss dropped the symbol from
# the push cycle silently and its on-chain oracle aged into staleness.
#   coingecko      — CoinGecko first, MARKET_DATA_PROVIDER seam as fallback.
#                    DEFAULT. The happy path is byte-for-byte the old behavior
#                    (source="coingecko"); only a MISS behaves differently.
#   coingecko_only — literal pre-#1710 behavior: CoinGecko, no fallback.
#   provider       — seam first, CoinGecko as fallback. Flip to this once the
#                    active provider can serve intraday crypto quotes.
#   provider_only  — seam only, NO CoinGecko fallback. Licensing-strict: a miss
#                    stays a miss rather than being filled from a free API.
# NOTE (#1798): this leg asks the INTRADAY seam, which Tiingo does not serve
# (daily bars only). Setting MARKET_DATA_PROVIDER=tiingo therefore does not
# break it — the intraday seam logs the substitution and resolves to yfinance,
# so 'provider'/'provider_only' keep pricing from there. A future vendor that
# declares the intraday seam without implementing it is still handled: the
# refusal is logged by name, CoinGecko serves under 'provider', and under
# 'provider_only' nothing is priced and the symbol is logged as excluded.
# Whatever the outcome, a symbol no source could price is NEVER given a
# fabricated price — it is excluded from the push with a named log line.
# ORACLE_CRYPTO_SOURCE=coingecko

# Pyth Hermes base URL (public endpoint by default; override for self-hosted).
PYTH_HERMES_URL=https://hermes.pyth.network
# Optional manual price overrides (inline JSON or a file path), applied on top of
# the cascade in any mode. Last-resort / demo pin. e.g. {"sSPY": 512.3}
ADMIN_PRICES_JSON=

# Secondary-source cross-check (#775): before pushing a NON-yfinance primary
# price (Pyth/Stork) on-chain, the oracle runner compares it to an independent
# yfinance reading and FAILS CLOSED if they diverge beyond this band (bps).
# Asymmetric: a MISSING / errored / non-positive / STALE yfinance secondary
# NEVER blocks a healthy primary (it only logs and proceeds). No-op when
# PRICE_SOURCE=yfinance (same source) or for admin pins. 0 to disable.
PRICE_CROSSCHECK_BAND_BPS=5000

# Secondary-source staleness window (#775 Phase 2, implemented): max age
# (seconds) of the yfinance secondary's own bar timestamp before it's treated
# as unusable for the cross-check above (same fail-open behavior as a missing
# secondary — a stale reading is never compared for divergence). Default 4
# days covers weekend + a 3-day holiday gap in equity-like intraday bars.
# Phase 2 on-chain enforcement (PriceOracle.sol) is still future work, Dan's call.
PRICE_CROSSCHECK_MAX_STALENESS_SECONDS=345600

# ── Contract addresses (Arc testnet, Chain ID 5042002 / 0x4cef52) ─────────
# (Chain ID aligned with README/CLAUDE; verify with Dan/contracts before relying
# on them — Dan owns the contracts + deploys them.)
#
# These bare (un-prefixed) names are consumed by the one-off e2e verifier
# (backend/archimedes/scripts/verify_arc_e2e.py). They are NOT what the running
# backend reads — the backend's ChainSettings reads the ARC_*-prefixed vars
# below. Keep them in sync if you set both.
PRICE_ORACLE_ADDRESS=0xe1c9f2b11be97097223a66a188fca541e07873a6
SYNTHETIC_FACTORY_ADDRESS=
AMM_ROUTER_ADDRESS=0xd5b829f9d364a8bbe1caf6c8b19cb05371b178f4
VAULT_FACTORY_ADDRESS=0xca873414070844aeb98b0bf1051f81969c79cc32
# v1.5 registry — the one production runs (confirmed via GET /api/config/contracts).
# The previous value here, 0x42d8a23e…, is the superseded v1 anchor-only deployment:
# an on-chain selector scan shows commit/executeTrade/reveal/getCommitment ABSENT on
# it, so a local stack pointed at it silently cannot do commit-before-trade.
REASONING_TRACE_REGISTRY_ADDRESS=0x9d81bfbfadb683cf77acda480e94e64088012847
ASSET_REGISTRY_ADDRESS=0x2d44550711137916df6175587d17886281a0fbc7
STRATEGY_REGISTRY_ADDRESS=0x728C264d0681b71c4Cc1D26a4fb14Ec29D9a90e4

# ── Contract addresses the BACKEND reads (ChainSettings, env_prefix=ARC_) ──
# Externalized contract addresses (roadmap T2.3). ChainSettings in
# backend/archimedes/chain/client.py reads each address field from its
# ARC_<FIELD> env var, falling back to the deployed Arc-testnet address baked
# into the code as a default. So these are ALL OPTIONAL: leave them unset to use
# the in-code defaults (the live Arc-testnet contracts); set one to repoint the
# backend at a freshly-deployed contract WITHOUT a code change. The values shown
# below are the current code defaults — uncomment + edit only the ones you need
# to override. (deploy_contracts.py prints these exact ARC_*=... lines after a
# deploy, ready to paste here.)
#
# Core contracts (note: ARC_AMM_ROUTER_ADDRESS etc. default to EMPTY in code and
# MUST be supplied for that contract to be usable — the values below are the
# live Arc-testnet deploys):
# ARC_USDC_ADDRESS=0x3600000000000000000000000000000000000000
# ARC_AMM_ROUTER_ADDRESS=0xd5b829f9d364a8bbe1caf6c8b19cb05371b178f4
# ARC_SYNTHETIC_FACTORY_ADDRESS=
# ARC_VAULT_FACTORY_ADDRESS=0xca873414070844aeb98b0bf1051f81969c79cc32
# ARC_REASONING_TRACE_REGISTRY_ADDRESS=0x9d81bfbfadb683cf77acda480e94e64088012847
# ARC_ASSET_REGISTRY_ADDRESS=0x2d44550711137916df6175587d17886281a0fbc7
# ARC_STRATEGY_REGISTRY_ADDRESS=0x728C264d0681b71c4Cc1D26a4fb14Ec29D9a90e4
#
# Synthetic token addresses (defaults = deployed Arc-testnet contracts):
# ARC_STSLA_ADDRESS=0xd514cd27baf762c650536765cde9b61c876abacd
# ARC_SNVDA_ADDRESS=0x805e75019a1291a598dfc134ad2519121a35fb11
# ARC_SSPY_ADDRESS=0x6fea38dedea0c6bb66ce93e5383c34385d8b889f
# ARC_SBTC_ADDRESS=0x317e82be8f7cba6c162ab968fcf695d88e8e0359
# ARC_SGOLD_ADDRESS=0xf384562c8bdafce52400eb6839f195695f6fa276
# ARC_SOIL_ADDRESS=0x46cead4120f17a968ba1168f1a56563962cf3c4b
# ARC_SNKY_ADDRESS=0x445b8f0f827a0d384d1b8ccf18cbc6ec8a543376
#
# Per-asset oracle addresses (defaults = deployed Arc-testnet contracts):
# ARC_STSLA_ORACLE_ADDRESS=0xe1c9f2b11be97097223a66a188fca541e07873a6
# ARC_SNVDA_ORACLE_ADDRESS=0xeb36acf88e739dd312de8278985262146a017374
# ARC_SSPY_ORACLE_ADDRESS=0xd8161a8eeab7c7100e2863abe3d5f346b5ff9e52
# ARC_SBTC_ORACLE_ADDRESS=0x6cc5f621c4e3b46152e69e5c9873689cbb4a85e8
# ARC_SGOLD_ORACLE_ADDRESS=0x35fccde01ae8728c7a7cb83c3f59c701ebecc633
# ARC_SOIL_ORACLE_ADDRESS=0x79f354524fd09af16d841a2221af2b2b7bc432c8
# ARC_SNKY_ORACLE_ADDRESS=0xcd34a4103ad64a3cf729b1b1a58295ccc957fcee

# ── Backend service config ─────────────────────────────────────────────────
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
LOG_LEVEL=INFO

# ── CORS (frontend talking to backend in dev) ──────────────────────────────
CORS_ORIGINS=http://localhost:8080,http://localhost:5173

# ── Public domain (used for CORS + security headers in production) ────────
# Leave BLANK for local dev. Setting it activates production mode (disables
# /docs, requires EMAIL_ENCRYPTION_KEY at startup, restricts CORS to this
# domain) — so a verbatim `cp .env.example .env` must NOT inherit it.
# Production: PUBLIC_DOMAIN=https://archimedes-arc.com
PUBLIC_DOMAIN=

# ── Better Auth + feature flags ───────────────────────────────────────────
# REQUIRED: generate locally, then paste value after `=`. Production value
# belongs in SSM /archimedes/prod/BETTER_AUTH_SECRET.
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
#
# The value below is a PUBLIC PLACEHOLDER so that a verbatim `cp .env.example .env`
# gives a working local stack. Leaving it empty broke EVERY docker compose command
# — including `down` — because compose resolves ${BETTER_AUTH_SECRET:?...} before
# it runs any action. It signs session cookies, so createAuth() REFUSES to boot
# with this exact value when NODE_ENV=production (auth/auth.js). Replace it for
# anything you deploy.
BETTER_AUTH_SECRET=insecure-local-dev-placeholder-change-me-before-any-deploy
BETTER_AUTH_URL=http://localhost:8080
BETTER_AUTH_INTERNAL_URL=http://auth:3000
BETTER_AUTH_TRUSTED_ORIGINS=http://localhost:8080,http://localhost:5173
NODE_ENV=development
APP_ENV=development
# Blank uses environment default: enabled outside production, disabled in production.
FEATURE_QUANT=
# OAuth providers enable only when both values in a pair are present.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ── Semantic retrieval for fusion candidate ranking ───────────────────────
# When ON, strategy_fusion.select_candidates() uses TF-IDF / embedding-based
# semantic reranking as a defense-in-depth second pass after keyword filtering.
# When OFF or when deps are missing, falls back to keyword-only ranking.
FUSION_SEMANTIC_RETRIEVAL=true

# ── AWS — corpus artifact storage + secrets surface ───────────────────────
# Set by T3.1 (issue #147) provisioning. Backend uses these via boto3 when
# running on EC2 with the archimedes-backend-role IAM instance profile attached.
# For local development, leave blank — the relevant code paths fall back to
# local filesystem (KB_ARTIFACT_DIR) and .env-based secrets.
#
# Region: us-east-1 — prod migrated to Dan's own AWS account
# (037613907429 / us-east-1) on 2026-06-24. (The earlier eu-west-2 default was
# the old shared London account; that's retired.)
#
# IAM policy reference: infra/iam/archimedes-backend-policy.json
# Provisioning runbook:  infra/iam/README.md
#
# NOTE (honesty): the corpus S3 buckets + DynamoDB table below are NOT yet
# provisioned on the prod account (only `archimedes-tfstate-*` and
# `archimedes-alb-logs-*` exist today). The corpus runs from the local JSONL
# manifest; these names are the build target for the KB/RAG work (issue #778),
# not live resources.
#
# NOTE (2026-09-01, audit P1-1): the three names below are now PROVISIONING
# TARGETS ONLY — no code reads these variables. Their only readers were
# services/s3_artifact_store.py and services/dynamodb_paper_index.py, both
# deleted as dead code. The live S3 paths read KB_S3_BUCKET
# (services/kb_artifacts.py) and ARCHIVE_BUCKET
# (scripts/archive_backtest_results.py). Kept commented as the record of record,
# matching infra/iam/archimedes-backend-policy.json.
AWS_REGION=us-east-1
# AWS_S3_ARTIFACTS_BUCKET=archimedes-corpus-artifacts-prod   # unread since 2026-09-01
# AWS_S3_PDFS_BUCKET=archimedes-paper-pdfs-prod              # unread since 2026-09-01
# AWS_DYNAMODB_PAPERS_TABLE=archimedes-papers-index          # unread since 2026-09-01
# AWS_ACCESS_KEY_ID=        # optional — only for local dev without instance profile
# AWS_SECRET_ACCESS_KEY=    # optional — only for local dev without instance profile

# Local-dev fallback: where corpus artifacts live when KB_S3_BUCKET
# is blank. Read by corpus_routes.py via the KB_ARTIFACT_DIR env var.
KB_ARTIFACT_DIR=/srv/corpus-artifact

# ── AWS SSM Parameter Store — production secrets surface ──────────────────
# Set by TS.2 (issue #176). Backend reads all params under this prefix at
# startup via boto3.client("ssm").get_parameters_by_path(...) — but ONLY when
# running in production mode (PUBLIC_DOMAIN set; see main.py), so a local run
# can never pull real prod secrets even with ambient AWS creds (issue #1044).
# Leave blank for local dev (uses .env values directly). Production sets this
# explicitly in its own deploy config (infra/ecs.tf), not from this file.
AWS_SSM_PATH_PREFIX=

# ── Paper-trading reasoning traces (issue #1575) ──────────────────────────
# Paper trading is the surface users actually touch, and a paper deployment
# that moves (paper) money with no hashed, owner-stamped, verifiable record of
# WHY is the product's central claim failing on its most-used path. Every
# paper decision publishes a ReasoningTrace through the same save_trace choke
# point the house agent uses, so #1556's ownership stamp and #1569's passport
# reachability apply to it for free.
#
# PAPER_TRACE_PUBLISH: default ON. Turning it off is a legitimate operator
#   choice but never a quiet one — every untraced decision gets a durable
#   `disabled` row, the settle logs a WARNING naming this variable, boot logs
#   an ERROR once, and GET /api/paper/deployments/{id} reports
#   trace_coverage.status="disabled". Absence is loud, per the fail-soft rule.
PAPER_TRACE_PUBLISH=true
# PAPER_TRACE_ANCHOR: default OFF, and one of TWO gates (the other is the
#   per-deployment `anchor_traces` opt-in). The commit-reveal reveal() writes
#   portfolio_before/portfolio_after — the user's holdings — on-chain
#   PERMANENTLY. #1556 exists because a user-owned trace publishing its full
#   portfolio to the internet is a leak; doing that by default for a
#   simulation the user ran privately would defeat that gate on purpose, and
#   nothing on-chain can be recalled. Cost is the secondary argument (~$500/yr
#   of USDC gas at 100 daily-rebalance deployments, and USDC IS gas on Arc).
PAPER_TRACE_ANCHOR=false
# PAPER_TRACE_BACKFILL_MAX: publish attempts per deployment per settle. The
#   first settle after this ships backfills a deployment's past decisions; the
#   bound keeps that from monopolising a cycle. Decisions past the bound are
#   recorded as retryable gaps (visible in trace_coverage), never dropped.
PAPER_TRACE_BACKFILL_MAX=500
