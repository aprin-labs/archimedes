    "cssnano": "^9.0.0",
    "eslint": "^10.9.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.5",
    "globals": "^17.11.0",
    "sass-embedded": "^1.102.0",
    "tailwindcss": "4.3.3",
