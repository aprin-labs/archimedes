    "radix-ui": "1.6.7",
    "tailwind-merge": "3.6.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-force-graph-2d": "^1.29.1",
    "viem": "^2.56.0"
  },
