# Archimedes Backend — Environment Variables
# Copy to .env and fill in values after deploying contracts.

# ─── Arc RPC ──────────────────────────────────────────────────
ARC_ARC_RPC_URL=https://rpc.testnet.arc.network
ARC_CHAIN_ID=13068200

# ─── Agent Account (calls rebalance, publishes traces) ────────
ARC_AGENT_PRIVATE_KEY=0x...
ARC_OWNER_PRIVATE_KEY=0x...

# ─── Contract Addresses (from Deploy.s.sol output) ───────────
ARC_USDC_ADDRESS=0x3600000000000000000000000000000000000000
ARC_AMM_ROUTER_ADDRESS=
ARC_SYNTHETIC_FACTORY_ADDRESS=
ARC_VAULT_FACTORY_ADDRESS=
ARC_REASONING_TRACE_REGISTRY_ADDRESS=
ARC_ASSET_REGISTRY_ADDRESS=

# ─── Synthetic Token Addresses ───────────────────────────────
ARC_STSLA_ADDRESS=
ARC_SNVDA_ADDRESS=
ARC_SSPY_ADDRESS=
ARC_SBTC_ADDRESS=
ARC_SGOLD_ADDRESS=

# ─── Oracle Addresses ────────────────────────────────────────
ARC_STSLA_ORACLE_ADDRESS=
ARC_SNVDA_ORACLE_ADDRESS=
ARC_SSPY_ORACLE_ADDRESS=
ARC_SBTC_ORACLE_ADDRESS=
ARC_SGOLD_ORACLE_ADDRESS=

# --- x402 / Circle Gateway ---
# Seller addresses are per-publisher (gateway_seller_address on the publisher row), not global.
# circlekit chain name (see circlekit.constants). arcTestnet for dev/test.
GATEWAY_CHAIN=arcTestnet
# Concurrent Circle signing calls per batch; confirm against Circle API rate limits before raising.
CHARGE_BATCH_SIZE=10
# Settlement sweep (P5): Gateway -> wallet threshold (decimal USDC, must exceed ~2.01 withdrawal fee).
SWEEP_WITHDRAW_THRESHOLD_USDC=10.0
# Settlement sweep (P5): minimum wallet USDC (raw 6-dec) to trigger on-chain depositToPool.
SWEEP_MIN_DEPOSIT_RAW=1000000

# ─── Publishing ──────────────────────────────────────────────────
# Minimum idle USDC (raw, 6-dec) a vault must hold before a strategy can be published. 1000000 = 1 USDC.
MARKETPLACE_MIN_VAULT_FUNDS_RAW=1000000
# Comma-separated wallet addresses allowed to publish strategies (incl. examples).
# Also EVIDENCE for the admin dashboard gate: an account is a platform admin when
# any wallet in its own linked-wallet set is listed here (#1648).
PLATFORM_ADMIN_WALLETS=0x...
# Comma-separated canonical account ids (auth_users.id) and/or emails granted the
# admin dashboard directly — the account-keyed allowlist (#1648). Derive it with
# `python backend/scripts/derive_platform_admin_accounts.py`.
PLATFORM_ADMIN_ACCOUNTS=
