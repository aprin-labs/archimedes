  "claims": [
    {
      "id": "claim_63e0a2f58cb248c1b1b220385003c99d",
      "statement": "Every library strategy carries an academic or practitioner paper anchor, a REGIME_TAG of bull, bear, or regime_neutral, and a documented v1 adaptation caveat; the strategy files under analytics-engine/strategies/ are the source of truth and the PAPER_* and REGIME_TAG constants are transcribed from them.",
      "evidence": [
        {
          "resource": "repo://docs/quant/strategy-library.md#L1-L31",
          "version": "repo-lines-v1:sha256:9edc0c73b4f2508045ad92a5fb83f91575e362da45a1abd7f0873cfc56814bdd:"
        }
      ]
    },
    {
      "id": "claim_65e063f255cd49f8ba516c6ec0011649",
      "statement": "A paper anchor is necessary but not sufficient for Tier-1 admission: a strategy must still pass the four-control gate, and which strategies currently pass is reported by the live rigor gate rather than by any document.",
